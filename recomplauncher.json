{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "MUA3 Recomp",
  "repo": "SilvioDiaz/mua3-pc-recomp",
  "game": {
    "kind": "folder",
    "label": "A folder with your Marvel Ultimate Alliance 3 base game and its 4.0.1 update (NSP, XCI, NSZ or XCZ), and prod.keys from your console.",
    "check": { "file": "prod.keys" }
  },
  "prepare": {
    "program": ["python/python.exe"],
    "args": ["-m", "installer.recomplauncher", "--game", "{game}", "--dest", "{install}/game"],
    "label": "Building the game from your copy: needs about 40 GB free and takes 15 to 60 minutes",
    "timeout": 10800
  },
  "start": {
    "program": ["game/mua3.exe"]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [{ "path": "{install}/game/mua3.ini" }]
    }
  ],
  "saves": ["{install}/game/profile"],
  "folders": {
    "saves": [{ "path": "{install}/game/profile" }],
    "logs": [{ "path": "{install}/game/logs" }]
  },
  "settings": [
    {
      "id": "window",
      "label": "Window",
      "help": "Fullscreen fills your screen without taking it over. F11 switches it in game too.",
      "choices": [
        { "label": "Windowed", "set": { "fullscreen": "0" } },
        { "label": "Fullscreen", "set": { "fullscreen": "1" } }
      ],
      "defaults": { "fullscreen": "0" }
    },
    {
      "id": "window_size",
      "label": "Window size",
      "help": "The size of the game's window in Windowed mode, in screen pixels.",
      "choices": [
        { "label": "1280 x 720", "set": { "window_size": "1280x720" } },
        { "label": "1600 x 900", "set": { "window_size": "1600x900" } },
        { "label": "1920 x 1080", "set": { "window_size": "1920x1080" } },
        { "label": "2560 x 1440", "set": { "window_size": "2560x1440" } }
      ],
      "defaults": { "window_size": "1920x1080", "fullscreen": "0" },
      "when": { "fullscreen": "0" }
    },
    {
      "id": "frame_rate",
      "label": "Frame rate",
      "help": "60 unlocks the game's 30 fps limit. Stages don't always hold 60 yet. Applies at the next start.",
      "choices": [
        { "label": "60 fps", "set": { "mua3_fps60": "1", "fps_limit": "60" } },
        { "label": "30 fps, as on Switch", "set": { "mua3_fps60": "0", "fps_limit": "30" } }
      ],
      "defaults": { "mua3_fps60": "1", "fps_limit": "60" }
    },
    {
      "id": "present",
      "label": "V-Sync",
      "help": "Mailbox is smooth without tearing. Fifo is classic V-Sync. Off shows frames at once and may tear.",
      "choices": [
        { "label": "Mailbox", "set": { "vk_present": "mailbox" } },
        { "label": "Fifo", "set": { "vk_present": "fifo" } },
        { "label": "Off", "set": { "vk_present": "immediate" } }
      ],
      "defaults": { "vk_present": "mailbox" }
    },
    {
      "id": "upscaler",
      "label": "Upscaling",
      "help": "How the picture is fitted to a window larger than the game's resolution. FSR keeps it sharper.",
      "choices": [
        { "label": "FSR", "set": { "upscaler": "fsr" } },
        { "label": "Bilinear", "set": { "upscaler": "bilinear" } }
      ],
      "defaults": { "upscaler": "fsr" }
    },
    {
      "id": "perf_overlay",
      "label": "Show FPS",
      "help": "The frame rate in the top right corner. F10 changes it in game too.",
      "choices": [
        { "label": "Off", "set": { "perf_overlay": "off" } },
        { "label": "FPS", "set": { "perf_overlay": "fps" } },
        { "label": "Full", "set": { "perf_overlay": "full" } }
      ],
      "defaults": { "perf_overlay": "off" }
    }
  ],
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your save data.", "open": "saves" },
    { "id": "logs", "label": "Logs", "help": "mua3.log of the last run and the four before it, for bug reports.", "open": "logs" }
  ]
}
